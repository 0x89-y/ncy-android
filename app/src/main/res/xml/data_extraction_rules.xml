<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer policy. Chats, profiles, and user settings remain
  transferable, but sync identity is installation-local. Restoring any of these
  files onto another phone would clone a device ID or an authentication secret.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ncy_device.xml" />
        <exclude domain="sharedpref" path="ncy_sync_peers.xml" />
        <exclude domain="sharedpref" path="ncy_phone_pairing.xml" />
        <exclude domain="sharedpref" path="ncy_phone_sync_server.xml" />
        <exclude domain="sharedpref" path="ncy_transport_settings.xml" />
        <exclude domain="sharedpref" path="ncy_pear_identity.xml" />
        <exclude domain="file" path="ncy_sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ncy_device.xml" />
        <exclude domain="sharedpref" path="ncy_sync_peers.xml" />
        <exclude domain="sharedpref" path="ncy_phone_pairing.xml" />
        <exclude domain="sharedpref" path="ncy_phone_sync_server.xml" />
        <exclude domain="sharedpref" path="ncy_transport_settings.xml" />
        <exclude domain="sharedpref" path="ncy_pear_identity.xml" />
        <exclude domain="file" path="ncy_sync/" />
    </device-transfer>
</data-extraction-rules>
