# Copy this file to:
#   %USERPROFILE%\.ncy\android-signing.properties
#
# Or set NCY_ANDROID_SIGNING_PROPERTIES to another absolute path.
# Never commit the populated file or the keystore.
# Release passwords are requested by build-apks.bat and are never stored here.

storeFile=D:/Ncy Secrets/ncy-android-release.jks
keyAlias=ncy-release
